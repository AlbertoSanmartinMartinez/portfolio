# Every variable the project reads, without values. See docs/guides/config-secrets.md.
# Secrets are set in the CI/CD secret store or the vault, never here.

# Read-only connection string for the db-local MCP server (local stack only).
DB_LOCAL_DSN=

# Public base URL of the site, used for canonical, hreflang and Open Graph links.
# Local: http://localhost:3000
SITE_URL=

# Contact API (specs/002). Locally, `scripts/stack.sh info` prints these for the stack's
# PostgreSQL and Mailpit. In production they are App Platform encrypted variables.
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=
# Secrets: never commit values (docs/guides/config-secrets.md).
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
