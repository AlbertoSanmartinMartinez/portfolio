{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge:*)",
      "Bash(glab mr merge:*)",
      "Bash(gh release create:*)",
      "Bash(glab release create:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Edit(**/AGENTS.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/.agents/**)",
      "Edit(**/.claude/**)",
      "Edit(**/.codex/**)",
      "Edit(**/.cursor/**)",
      "Edit(**/.githooks/**)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/.github/CODEOWNERS)",
      "Edit(**/.gitlab/CODEOWNERS)",
      "Edit(**/.gitlab-ci.yml)",
      "Edit(**/docs/invariants.md)",
      "Edit(**/scripts/check_harness.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/block-unsafe-commands.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/format-edited-file.sh" }
        ]
      }
    ]
  }
}
